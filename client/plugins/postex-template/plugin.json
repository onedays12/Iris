{
  "schema_version": 2,
  "name": "postex-template",
  "display_name": { "zh": "PostEx 模板", "en": "PostEx Template" },
  "version": "2.0.0",
  "description": {
    "zh": "PostEx DLL 插件模板，提供 spawn-dll 与 inject-dll 两条验证链路",
    "en": "PostEx DLL plugin template with spawn-dll and inject-dll verification chains"
  },
  "capabilities": { "command_ids": [90] },
  "hashes": {
    "bin/postex_template.x64.dll": "3003b8222269fe350eed0297ec346a5dbe32915422e79fa173b87085ec2dedd8",
    "bin/postex_template.x86.dll": "c69a71b7e653c380091c0aa95b1b64f5024c76d22daaf9a36319f1c972328c58",
    "postex-template.manifest.json": "3ac6be84dfde105a6fe079d5b688ca6de71d2b2a45c7e49ab1a34d4ee6e1d3d8"
  },
  "actions": [
    {
      "id": "postex_template_spawn",
      "label": { "zh": "模板 Spawn DLL", "en": "Template Spawn DLL" },
      "description": {
        "zh": "创建宿主进程并加载 PostEx template DLL",
        "en": "Create a host process and load the PostEx template DLL"
      },
      "module": "postex-template.manifest.json",
      "postex": {
        "description": "postex-template-spawn",
        "spawn_path": "C:\\Windows\\System32\\cmd.exe",
        "spawn_path_by_arch": {
          "amd64": "C:\\Windows\\System32\\cmd.exe",
          "x86": "C:\\Windows\\SysWOW64\\cmd.exe"
        },
        "spawn_args": "/c timeout /t 30 /nobreak > nul"
      }
    },
    {
      "id": "postex_template_inject",
      "label": { "zh": "模板 Inject DLL", "en": "Template Inject DLL" },
      "description": {
        "zh": "注入 PostEx template DLL 到指定进程",
        "en": "Inject the PostEx template DLL into a target process"
      },
      "module": "postex-template.manifest.json",
      "postex": {
        "mode": "inject-dll",
        "description": "postex-template-inject"
      }
    }
  ]
}
