  "actions": [
    {
      "id": "tp_work",
      "label": {
        "zh": "TP_WORK注入",
        "en": "TP_WORK Injection"
      },
      "description": {
        "zh": "把 TP_WORK 插入目标线程池高优先级队列。目标须为 x64。",
        "en": "Insert a TP_WORK item into the target thread pool high-priority queue. x64 target only."
      },
      "os": [
        "windows"
      ],
      "arch": [
        "amd64"
      ],
      "artifact": "bin/variant2_tpwork_insertion.x64.o",
      "fields": [
        {
          "name": "pid",
          "label": {
            "zh": "目标 PID",
            "en": "Target PID"
          },
          "type": "int32",
          "placeholder": "1234",
          "required": true
        },
        {
          "name": "shellcode",
          "label": {
            "zh": "Shellcode",
            "en": "Shellcode"
          },
          "type": "file",
          "accept": ".bin",
          "required": true,
          "help": {
            "zh": "x64 shellcode 的 .bin 文件，空文件或超过 10MB 会被拒绝。",
            "en": "x64 shellcode .bin. Empty or larger than 10MB is rejected."
          }
        }
      ]
    },
    {
      "id": "tp_wait",
      "label": {
        "zh": "TP_WAIT注入",
        "en": "TP_WAIT Injection"
      },
      "description": {
        "zh": "用 Event + TP_WAIT 向目标 IOCP 投完成包。空名字使用匿名事件。",
        "en": "Queue a completion packet via Event + TP_WAIT. Empty name uses an anonymous event."
