        {
          "name": "shellcode",
          "label": {
            "zh": "Shellcode",
            "en": "Shellcode"
          },
          "type": "file",
          "accept": ".bin",
          "required": true,
          "help": {
            "zh": "x64 shellcode 的 .bin 文件，空文件或超过 10MB 会被拒绝。",
            "en": "x64 shellcode .bin. Empty or larger than 10MB is rejected."
          }
        },
        {
          "name": "name",
          "label": {
            "zh": "事件名",
            "en": "Event name"
          },
          "type": "string",
          "placeholder": "",
          "required": false,
          "help": {
            "zh": "留空则创建匿名 Event，不进入对象命名空间。",
            "en": "Leave empty for an anonymous Event (not in the object namespace)."
          }
        }
      ]
    },
    {
