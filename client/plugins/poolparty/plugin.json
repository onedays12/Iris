            "en": "Target PID"
          },
          "type": "int32",
          "placeholder": "1234",
          "required": true
        },
        {
          "name": "shellcode",
          "label": {
            "zh": "Shellcode",
            "en": "Shellcode"
          },
          "type": "file",
          "accept": ".bin",
          "required": true,
          "help": {
            "zh": "x64 shellcode 的 .bin 文件，空文件或超过 10MB 会被拒绝。",
            "en": "x64 shellcode .bin. Empty or larger than 10MB is rejected."
          }
        },
        {
          "name": "name",
          "label": {
            "zh": "ALPC 端口名",
            "en": "ALPC port name"
          },
          "type": "string",
          "placeholder": "",
          "required": false,
          "help": {
            "zh": "留空则 \\RPC Control\\<16 位 hex>。短名自动加 \\RPC Control\\。以 \\ 开头则当完整 NT 路径。",
            "en": "Empty → \\RPC Control\\<16-hex>. Short names get \\RPC Control\\ prepended. A leading \\ is treated as a full NT path."
          }
        }
      ]
    },
    {
