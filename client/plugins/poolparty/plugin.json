{
  "schema_version": 2,
  "name": "poolparty",
  "display_name": {
    "zh": "PoolParty",
    "en": "PoolParty"
  },
  "version": "1.0.0",
  "description": {
    "zh": "通过目标进程线程池注入 x64 shellcode（变体 2–8）。需要 OpenProcess + DuplicateHandle 权限，目标须为 x64 且已有线程池。",
    "en": "Inject x64 shellcode via the target process thread pool (variants 2–8). Needs OpenProcess + DuplicateHandle. Target must be x64 with an existing thread pool."
  },
  "capabilities": {
    "command_ids": [
      70
    ]
  },
  "hashes": {
    "bin/variant2_tpwork_insertion.x64.o": "50a82880fc974060668ed532bb478e86161a66e2f198112643c1a4fcc2331878",
    "bin/variant3_tpwait_insertion.x64.o": "4737e4a10f9451a5f514bf1040e61c1919db0173a0dc8f3ef74dbc67418096d6",
    "bin/variant4_tpio_insertion.x64.o": "c4fe365184ad0b371f7db3af8e3f92918f7040bb404c320c0c3fa092cacf9d7d",
    "bin/variant5_tpalpc_insertion.x64.o": "cc2d55592bee8347f8a3dac9a9389eeed2ff9af88177f052e7443590204a7ce3",
    "bin/variant6_tpjob_insertion.x64.o": "c4477b8eefaabf091b6fea11fe2413d38a1bbca6de1ba00e7086d47588733665",
