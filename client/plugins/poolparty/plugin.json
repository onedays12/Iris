      "description": {
        "zh": "用 Job 完成通知向目标 IOCP 投包。会把当前 Beacon 进程 Assign 进该 Job。空名字使用匿名 Job。",
        "en": "Queue via a job completion notification. Assigns the current Beacon process into the job. Empty name uses an anonymous job."
      },
      "os": [
        "windows"
      ],
      "arch": [
        "amd64"
      ],
      "artifact": "bin/variant6_tpjob_insertion.x64.o",
