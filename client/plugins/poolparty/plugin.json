            "en": "Target PID"
          },
          "type": "int32",
          "placeholder": "1234",
          "required": true
        },
        {
          "name": "shellcode",
          "label": {
            "zh": "Shellcode",
            "en": "Shellcode"
          },
          "type": "file",
          "accept": ".bin",
          "required": true,
          "help": {
            "zh": "x64 shellcode 的 .bin 文件，空文件或超过 10MB 会被拒绝。",
            "en": "x64 shellcode .bin. Empty or larger than 10MB is rejected."
          }
        },
        {
          "name": "name",
          "label": {
            "zh": "文件名",
            "en": "File name"
          },
          "type": "string",
          "placeholder": "",
          "required": false,
          "help": {
            "zh": "留空则使用 %TEMP% 下随机 .tmp；相对路径相对 Beacon 当前目录。打完会尝试删除。",
            "en": "Empty uses a random .tmp under %TEMP%. Relative paths are vs Beacon CWD. Deleted after trigger."
          }
        }
      ]
    },
    {
      "id": "tp_alpc",
      "label": {
        "zh": "TP_ALPC注入",
        "en": "TP_ALPC Injection"
      },
      "description": {
        "zh": "用命名 ALPC 端口向目标 IOCP 投包。空名字使用 \\RPC Control\\<随机>；短名自动加此前缀。",
        "en": "Queue via a named ALPC port. Empty name uses \\RPC Control\\<random>; a short name gets that prefix."
      },
      "os": [
        "windows"
      ],
      "arch": [
        "amd64"
      ],
      "artifact": "bin/variant5_tpalpc_insertion.x64.o",
      "fields": [
        {
          "name": "pid",
          "label": {
