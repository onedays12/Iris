        "en": "Queue via overlapped file write + TP_IO. Empty name writes a random %TEMP% .tmp and deletes it afterwards."
      },
      "os": [
        "windows"
      ],
      "arch": [
        "amd64"
      ],
      "artifact": "bin/variant4_tpio_insertion.x64.o",
      "fields": [
